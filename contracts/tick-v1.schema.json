{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulated tick v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stream_id",
    "event_id",
    "sequence",
    "symbol",
    "price",
    "source",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "event_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9a-f]{32}:FAKE[0-9]*:[1-9][0-9]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "symbol": {
      "type": "string",
      "pattern": "^FAKE[0-9]*$"
    },
    "price": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000000000
    },
    "source": {
      "const": "market-data-python"
    },
    "timestamp": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
