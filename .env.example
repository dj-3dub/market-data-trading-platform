# Run make setup to create .env with a unique Grafana password.
# Do not copy this blank password into .env; setup generates it for you.
# GRAFANA_ADMIN_PASSWORD=

# These workload values are read automatically by Compose.
TICK_INTERVAL_SECONDS=1
# Port overrides can be placed here, but pass the same values to host-side checks:
# WEB_PORT=8090 API_PORT=8091 make up doctor test
